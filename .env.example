# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — SERVER ONLY, never expose to the client or browser bundle
# Used only by: npm run bootstrap:super-admin
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time SUPER_ADMIN bootstrap (npm run bootstrap:super-admin)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_ADDRESS=

# Local test users (npm run seed:test-users) — dev/staging only
# SEED_EMAIL_DOMAIN=test.telepastors.local

# Optional: personal access token for npm run set:auth-password-policy
# SUPABASE_ACCESS_TOKEN=your-access-token

# Optional: fallback WhatsApp template when DB templates are unavailable
NEXT_PUBLIC_WHATSAPP_MESSAGE_TEMPLATE=Hello {name}, following up about {campaign}...

# Optional: SMS provider (Twilio)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
